# Copy these values into backend/.env on Ubuntu before the final cutover.
# Copy the real secret values securely from your local backend/.env, never Git.
CONVEX_URL=https://knowing-horse-0.convex.cloud
CONVEX_TRADING_SECRET=REPLACE_WITH_EXISTING_LOCAL_VALUE
CONVEX_RESEARCH_SECRET=REPLACE_WITH_EXISTING_LOCAL_VALUE
CONVEX_CREDENTIAL_KEY=REPLACE_WITH_EXISTING_LOCAL_VALUE
ANALYSIS_SERVICE_SECRET=REPLACE_WITH_EXISTING_LOCAL_VALUE
CONVEX_LIBRARY_ENABLED=true
CONVEX_ACCOUNTS_ENABLED=true
CONVEX_RUNTIME_ENABLED=true
CONVEX_ORDER_JOURNAL_ENABLED=true
DELTA_EVENTS_ENABLED=true

# Frontend build-time variables belong in Vercel, not the backend container.
# NEXT_PUBLIC_CONVEX_URL=https://knowing-horse-0.convex.cloud
# NEXT_PUBLIC_CONVEX_LIBRARY_ENABLED=true
